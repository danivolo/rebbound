    "# Suggerimento iniziale per il primo fit, dopodiché utilizzo iterativamente i parametri ottimali trovati\n",
    "p_small = [0.03673063, 0.03965545]                                  # c0, c1\n",
    "p_large = [60,20,0.02]                                              # c0, c1, c2\n",
    "p_general = [-3.47695202, -0.31433968,  0.01338993, -0.34219638]    # c0, c1, c2, c3\n",
    "p_b = [1000] \n",
    "\n",
    "color = ['C0','C1','C2','C3','C4','C5','C6','C7','C8','C9']\n",
    "i = 0\n",
    "j = 0\n",
    "k = 0\n",
    "\n",
    "# Definisco gli andamenti delle accelerazioni con cui eseguire i fit\n",
    "def a_vsmall(x,c0,c1):\n",
    "    return c0*x + c1\n",
    "\n",
    "def a_vlarge(x,c0,c1,c2):\n",
    "    return c0/(x-c2)**2+c1\n",
    "\n",
    "def a_vgeneral(x,c0,c1,c2,c3):\n",
    "    from scipy.special import erf\n",
    "    X = c3*(x-c1)\n",
    "    return (erf(X)-2*X/np.sqrt(np.pi)*np.exp(-X**2))*c0/(x-c1)**2 + c2\n",
    "\n",
    "def b90_func(x,c0):\n",
    "    return c0/(x)**2\n",
    "\n",
    "fig0, ax0 = plt.subplots(figsize=(8,5))\n",
    "fig1, ax1 = plt.subplots(figsize=(8,5))\n",
    "fig2, ax2 = plt.subplots(figsize=(8,5))\n",
    "fig3, ax3 = plt.subplots(figsize=(8,5))\n",
    "\n",
    "# Alla fine abbiamo deciso di non studiare il caso con dispersione di velocità, quindi nel codice faccio i for loop senza quello\n",
    "\n",
    "# for scale in [scales[0]]:\n",
    "#     fixed_scale = [results for results in pickle_file if results[\"scale\"] == scale]                   # se utilizzo scale\n",
    "for m_BH in [m_BHs[-1]]:\n",
    "    fixed_M = [results for results in pickle_file if results[\"m_BH\"] == m_BH]   \n",
    "    for m_host in [m_hosts[-1]]:\n",
    "        fixed_m = [results for results in fixed_M if results[\"m_host\"] == m_host]\n",
    "\n",
    "        # Leggo le quantità salvate nei file pickles\n",
    "        b90_th = np.array([results[\"b90_th\"] for results in fixed_m])\n",
    "        b90_fit = np.array([results[\"b90_fit\"] for results in fixed_m])\n",
    "        a_b90_fit = -np.array([results[\"a_b90_fit\"] for results in fixed_m])\n",
    "        a_b90_th = -np.array([results[\"a_b90_th\"] for results in fixed_m])  # era  a_th per scan_log_center.pickle\n",
    "        a_sim = -np.array([results[\"a_sim\"] for results in fixed_m])    # era a_lin_fit per scan_log_center.pickle\n",
    "        slow_stars_fraction = np.array([results[\"slow_stars_fraction\"] for results in fixed_m])\n",
    "\n",
    "        ################# ANDAMENTI\n",
    "        # costruisco le maschere per fare i fit di a_df_small, a_df_large, a_df_generale nei rispettivi range di velocità \n",
    "        threshold = 0.5 * np.max(a_sim)   \n",
    "        indices = np.where(a_sim > threshold)[0]   \n",
    "        Vs_fast = Vs[indices[-1]]       \n",
    "        Vs_low = Vs[np.argmax(a_sim)] \n",
    "        cut_low = (1  < Vs) & (Vs <= Vs_low)         # intervallo per il fit a velocità basse\n",
    "        cut_high = Vs > Vs_fast                      # intervallo per il fit a velocità alte\n",
    "        cut_general = (1  < Vs) & (Vs < 20)          # intervallo per il fit a velocità generiche\n",
    "\n",
    "        cut_low2 = (1< Vs) & (Vs < 2)                # intervallo per mostrare potenza Vx\n",
    "        cut_high2 = (50< Vs) & (Vs < 90)             # intervallo per mostrare potenza Vx^-2\n",
    "\n",
    "        ax0.plot(Vs, a_sim,'k.-',label='a_sim',alpha = 0.2)  \n",
    "        popt_small, _ = curve_fit(a_vsmall,Vs[cut_low],a_sim[cut_low],p_small)\n",
    "        ax0.plot(Vs[cut_low], a_vsmall(Vs[cut_low],*popt_small),'r--',label='small $v_s$ fit',alpha = 0.2,linewidth=5)\n",
    "        popt_large, _  = curve_fit(a_vlarge,Vs[cut_high],a_sim[cut_high],p_large)\n",
    "        ax0.plot(Vs[cut_high], a_vlarge(Vs[cut_high],*popt_large),'b--',label='large $v_s$ fit',alpha = 0.2,linewidth=5)\n",
    "        popt_general, _ = curve_fit(a_vgeneral,Vs[cut_general],a_sim[cut_general],p_general)\n",
    "        ax0.plot(Vs[cut_general], a_vgeneral(Vs[cut_general],*popt_general),'g--',label='general $v_s$ fit',alpha = 0.2, linewidth=5)\n",
    "\n",
    "        ax0.plot(Vs[cut_low2], Vs[cut_low2]/400,'k-' )              # divido/moltiplico per scegliere l'altezza\n",
    "        ax0.plot(Vs[cut_high2], Vs[cut_high2]**(-2)*10,'k-' )\n",
    "\n",
    "        p_small = popt_small                        # aggiorno i suggerimenti sui parametri dei fit\n",
    "        p_large = popt_large\n",
    "        p_general = popt_general       \n",
    "    \n",
    "        ax0.set_title('Accelerazioni')\n",
    "        ax0.set_xlabel('Vs')\n",
    "        ax0.set_ylabel('a')\n",
    "        ax0.set_xscale('log')\n",
    "        ax0.set_yscale('log')\n",
    "        ymin, ymax = ax0.get_ylim()\n",
    "\n",
    "        ################# CONFRONTO a_sim vs a_b90_fit\n",
    "        # fattore numerico di ragguaglio che sembra necessario per far tornare la formula di chandrasekhar (con b90 teorico o sperimentale) con a_sim\n",
    "        factor = 8.2 #4.2 per il caso Chandrasekhar / Vs^(1/3)\n",
    "        ax1.plot(Vs, a_sim,'k.-',label='a_sim',alpha = 0.2)\n",
    "        ax1.plot(Vs, a_b90_fit/factor, 'C1.-',label=f'a_b90_fit/{factor:.2f}')  #+ 0.000001*m_host  / slow_stars_fractions  /Vs**(1/3)\n",
    "        ax1.plot(Vs, a_b90_th/factor, 'C2.-', label=f'a_b90_th/{factor:.2f}')\n",
    "\n",
    "        # Verifico cosa succede se utilizzo b_90_th = GM/Vs^2\n",
    "        # b90_th2 = sim.G*m_BH/Vs**2\n",
    "        # rho = m_host/((boxL*nx)*(boxL*ny)) # surf density\n",
    "        # rho_slow_stars = rho*slow_stars_fraction\n",
    "        # b_max =  boxL* nx\n",
    "        # Lambda_th2 = b_max/b90_th2\n",
    "        # a_th2 = -4*np.pi*((sim.G)/Vs)**2* m_BH*np.log(Lambda_th2)*rho_slow_stars   \n",
    "        # ax1.plot(Vs, a_th2 + 0.01, 'C2.-', label=f'a_th2')\n",
    "\n",
    "        # ax1.plot(Vs[cut_low2], Vs[cut_low2]/400,'k-' )\n",
    "        # ax1.plot(Vs[cut_high2], Vs[cut_high2]**(-2)*10,'k-' )\n",
    "\n",
    "        ax1.set_title('Confronto a_sim vs a_b90_fit')\n",
    "        ax1.set_xlabel('Vs')\n",
    "        ax1.set_ylabel('a')\n",
    "        ax1.set_xscale('log')\n",
    "        ax1.set_yscale('log')\n",
    "        # ax1.set_ylim(ymin,ymax)\n",
    "\n",
    "        ################# b90\n",
    "        cut_b = Vs > 3\n",
    "        popt, _ = curve_fit(b90_func,Vs[cut_b],b90_fit[cut_b],p_b)\n",
    "\n",
    "        ax2.plot(Vs, b90_fit,'C1.-',label=f'b90_fit',alpha = 0.5)\n",
    "        # ax2.plot(Vs, b90_func(Vs,*popt),'C3--',label=r'$1/Vs^2$',alpha = 0.2, linewidth=5)\n",
    "        ax2.plot(Vs, b90_th,'C2.-',label=r'b90_th = G m_BH / $Vs^2$',alpha = 0.5)\n",
    " \n",
    "        ymin, ymax = ax2.get_ylim() \n",
    "        # ax2.vlines(v_cross,ymin,ymax)\n",
    "        ax2.set_title(r'90° deflection radius')\n",
    "        ax2.set_xlabel('Vs')\n",
    "        ax2.set_ylabel('b90')\n",
    "        ax2.set_yscale('log')\n",
    "        ax2.set_xscale('log')\n",
    "        ax2.set_ylim(0.01,200)\n",
    " \n",
    "        ################# SLOW STARS\n",
    "        ax3.plot(Vs,slow_stars_fraction,color[j],alpha = 0.8)\n",
    "\n",
    "        ax3.set_title('slow stars fraction')\n",
    "        ax3.set_xlabel('Vs')\n",
    "        ax3.set_ylabel('Fraction of stars')\n",
    "        ax3.set_xscale('log')\n",
    "\n",
    "        xlow, xhigh = 1, 100\n",
    "        ax0.set_xlim(xlow,xhigh)\n",
    "        ax1.set_xlim(xlow,xhigh)\n",
    "        # ax2.set_xlim(xlow,xhigh)\n",
