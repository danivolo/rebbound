    "####################################### Definisco funzione che lavora in tempo reale\n",
    "def heartbeat(sim_pointer):\n",
    "    global x_BH, v_BH, spawn_cycle, particle_hash, particle_row, print_cycle, b90_th, times \n",
    "\n",
    "    sim = sim_pointer.contents\n",
    "    t = sim.t\n",
    "    times = np.append(times,t)\n",
    "\n",
    "    ########################################## Immissione delle particelle da destra\n",
    "    print_dt = 0.1                              # intervallo di tempo per la stampa del tempo durante la simulazione di Rebound\n",
    "    spawn_dt = S.boxL*S.nx/S.ncols/(S.Vx)       # tempo impoiegato dalle particelle a percorrere la distanza tra una colonna e l'altra\n",
    "                                                # (intervallo di tempo tra l'immissione di particelle dal lato destro)\n",
    "\n",
    "    if np.floor(t/spawn_dt)>spawn_cycle:        # condizione per l'immissione di particelle\n",
    "        spawn_cycle += 1\n",
    "        x = S.nx*S.boxL/2                       # ascissa da cui immettere le nuove particelle\n",
    "        \n",
    "        for row,y in enumerate(S.ys):           # aggiungiamo particelle dal lato destro all'altezza di ogni riga\n",
    "            sim.add(m=S.m_host/S.N,x=x,y=y,vx = sp.particles_initial_velocity('delta', Vx),r=S.boxL/40,hash=particle_hash)   # r è il raggio delle particelle (solo estetico)\n",
    "            particle_row = np.append(particle_row, row)\n",
    "            particle_hash += 1\n",
    "        t = 0\n",
    "\n",
    "    ######################################## Ciclo per stampare evoluzione temporale della sim\n",
    "    if np.floor(t/print_dt)>print_cycle:       # condizione per la stampa del tempo         \n",
    "        print_cycle += 1\n",
    "        print(f\"\\rTempo: {sim.t:.2f}/{S.T:.2f}\", end=\"\")  \n",
    "\n",
    "\n",
    "    ######################################## Salvo la posizione del black hole \n",
    "    S.v_BH = np.append(S.v_BH,sim.particles[\"BH\"].vx)\n",
    "    S.x_BH = np.append(S.x_BH,sim.particles[\"BH\"].x)\n",
    "\n",
    "\n",
    "number = random.randint(1000,9999)              # creo un numero di 4 cifre randomico, per non avere mai errore di utilizzo \n",
    "                                                # della stessa porta se utilizzo la visualizzazione tramite widget di Rebound\n",
    "\n",
    "#########################################\n",
    "\n",
    "# Definisco vari setup\n",
    "M_grid = (50, 50, 1)    # 10,100,10\n",
    "m_grid = (100, 100, 1)  # 10,100,10\n",
    "V_grid = (-1,2,100)\n",
    "V_scale = 'log'\n",
    "m_BHs = np.linspace(*M_grid)\n",
    "m_hosts = np.linspace(*m_grid)\n",
    "Vxs = np.logspace(*V_grid)\n",
    "# Vxs = np.linspace(1,100,5) \n",
    "# scales = [4,16,64]\n",
    "scale = None\n",
    "\n",
    "scan_name = 'scan_log_Center_Esame_ProveFinali'\n",
    "scan_folder = rf\"C:\\Users\\ACER\\Desktop\\Output Rebound\\for loop Luca\\{scan_name}\"        # qui potrei trovare un modo automatico di chiamare le cartelle con le quantità tenute fisse, \n",
    "                                                                                        # e i file all'interno con la variabile che varia. Potrei anche in automatico scrivere un file \n",
    "                                                                                        # txt all'interno della cartella scan cno lo stato della simulazione\n",
    "\n",
    "Path(scan_folder).mkdir(parents=True, exist_ok=True)\n",
    "timesstamp = time.strftime(\"%H%M%S\")\n",
    "pickle_path = Path(scan_folder) / f\"{scan_name}_{timesstamp}.pickle\"    # aggiungo un timestamp al file .pickle che verrà creato per ridurre al minimo il rischio di sovrascrivere il file\n",
    "out = []\n",
    " \n",
    "savefig = False\n",
    "savepickle = False\n",
    "\n",
    "\n",
    "def check_pickle(folder: Path):                                         # Nel caso remoto in cui il file pickle esista già, chiede se vogliamo sovrascriverlo o abortire\n",
    "    if folder.exists():\n",
    "        risposta = input(f\"ATTENZIONE: Il file {folder} esiste già. Vuoi sovrascriverlo? [y/n]: \").strip().lower()\n",
    "        if risposta != 'y':\n",
    "            raise FileExistsError(f\"Operazione annullata. Cambiare 'scan_name' per non sovrascriverlo.\")\n",
    "        else:\n",
    "            print(f\"Sovrascrivo il file\")\n",
    "\n",
    "check_pickle(pickle_path)\n",
    "\n",
    "# SCANSIONI sulla griglia m_BH x m_host x Vx\n",
    "\n",
    "# Per ogni iterazione viene eseguita una simulazione definendo la classe sim = rebound.Simulation() e attribuendole la funzione heartbeat, \n",
    "# definita sopra, la quale permette di eseguire delle linee di codice ad ogni step temporale della simulazione.\n",
    "\n",
    "# Gli attributi della classe li specifichiamo utilizzando la classe setup_class costruita nel modulo Setup.py, che è un utile contenitore\n",
    "# di tutte le quantità necessarie per sim. \n",
    "\n",
    "\n",
    "# for scale in scales:\n",
    "for m_BH in m_BHs:\n",
    "    for m_host in m_hosts:\n",
    "        sub_folder = rf'\\M{m_BH:.0f}m{m_host:.0f}'          # Creo il nome delle sottocartelle in cui salvare le immagini\n",
    "        frame = 1                                           # Inizializzo il suffisso da aggiungere al nome delle immagini\n",
    "        for Vx in Vxs: \n",
    "            print('\\n' + sub_folder + f'V{Vx:.3f}')         # Stampo l'iterazione corrente\n",
    "            ######################################### \n",
    "            # Definisco la classe setup_class e ne specifico gli attributi (vedere suo help)\n",
    "            S = sp.setup_class(boxL=10, nx = 10, ny = 5, N=500, nrows = 20, m_host=m_host, m_BH = m_BH, Vx = Vx, T = 10, position = 'center', scale=scale)\n",
    "            \n",
    "            sim = rebound.Simulation()\n",
    "            sim.heartbeat = heartbeat\n",
    "            # sim.widget(port=number,size=(1000,1000))      # attivare se si vuole la visualizzazione tramite widget di Rebound\n",
    "            sim.configure_box(S.boxL,S.nx,S.ny)             # imposto dimensioni della box\n",
    "            sim.boundary = \"open\"                           # scelgo condizioni al bordo \"aperte\", ovvero le particelle che escono vengono rimosse dalla simulazione\n",
    "            sim.gravity = \"tree\"                            # approssimo le interazioni gravitazionali con uno schema ad albero, per velocizzare le simulazioni  \n",
    "            sim.opening_angle2 = 1.5                        # parametro dello schema ad albero\n",
    "            sim.integrator = \"leapfrog\"                     # utilizzo integratore numerico leapfrog\n",
    "            sim.softening = 0.1                             # scelgo valore di softening per evitare divergenze con incontri tra particelle troppo ravvicinati\n",
    "              \n",
    "            np.random.seed(0)                               # scelgo un seed di riferimento per avere distese di particelle con velocità riproducibili quando scelgo distribuzioni non delta-like\n",
    "\n",
    "            times = [0]                                     # inizializzo il tempo della sim\n",
    "\n",
    "            particle_row = []                               # inizializzo l'indice di riga a cui è stata aggiunta ciascuna particella (utile poi per il calcolo di b90)\n",
    "            particle_hash = 0\n",
    "\n",
    "            spawn_cycle = 0                                 # contatore usato nell'immissione di nuove particelle (vedere heartbeat)\n",
    "            print_cycle = 0                                 # contatore usato nella stampa del tempo durante l'evoluzione temporale della sim di Rebound (vedere heartbeat)\n",
    "\n",
    "            for x in S.xs:\n",
    "                for j,y in enumerate(S.ys):                 # aggiunta delle N particelle lungo le righe e colonne \n",
    "\n",
    "                    sim.add(m=S.m_host/S.N,x=x,y=y,vx = sp.particles_initial_velocity('delta', Vx),r=S.boxL/40,hash=particle_hash)\n",
    "                    particle_row = np.append(particle_row, j)\n",
    "                    particle_hash += 1\n",
    "\n",
    "            sim.add(m=S.m_BH,x=S.x_BH[0],y=0,vx=S.v_BH[0],vy=0,hash=\"BH\",r=S.boxL/10)   # aggiungo il buco nero, con raggio maggiore per essere distinto facilmente (solo estetica)\n",
    "            sim.collision = \"none\"\n",
    "           \n",
    "            sim.integrate(S.T)\n",
    "            ######################################### \n",
    "            # Cartella dello scan delle simulazioni, in cui viene salvato il file .pickle contentente tutte le run e il file di riepilogo .tx\n",
    "            # Sottocartella in cui vengono salvate le immagini prodotte durante la singola run.\n",
    "            fig_folder = scan_folder + sub_folder   \n",
    "\n",
    "            # Ora che è finita l'evoluzione temporale stimo l'accelerazione del BH tramote un fit lineare della sua velocità nel tempo, ottenendo a_sim.  \n",
    "            # Inoltre calcolo b90 tramite metodo sperimentale e formula teorica e li uso nella formula di Chandrasekhar, nella quale utilizzo come frazione di stelle\n",
    "            # con velocità più bassa del BH il conto fatto in compute_velocity_dispersion\n",
    "\n",
    "            b90_fit = S.compute_deflection_angle(sim, particle_row, fig_folder, frame, savefig)\n",
    "            b90_th = S.compute_velocity_dispersion(sim,fig_folder, frame, savefig)\n",
    "            a_b90_th, a_b90_fit, a_sim = S.compute_acc_comparison(sim, b90_th, b90_fit, times, fig_folder, frame, savefig)\n",
    "\n",
    "            # Il ciclo è finito\n",
    "            frame += 1                                      # aggiorno il suffisso delle immagini\n",
    "            results = {\n",
    "                # \"scale\": scale,     # se uso scale\n",
    "                \"m_BH\": m_BH,\n",
    "                \"m_host\": m_host,\n",
    "                \"Vx\": Vx, \n",
    "                \"b90_th\": b90_th,\n",
    "                \"b90_fit\": b90_fit,  \n",
    "                \"a_b90_th\": a_b90_th,\n",
    "                \"a_b90_fit\": a_b90_fit,\n",
    "                \"a_sim\": a_sim,\n",
    "                \"slow_stars_fraction\": S.slow_stars_fraction\n",
    "            }   \n",
    "            \n",
    "            out.append(results)                             # aggiungo le quantità calcolate in questo ciclo nel file .pickle\n",
    "\n",
    "            # salvo i risultati in tempo reale nel file di output .pickle, così anche interrompendo la sim si hanno risultati                                             \n",
    "            if savepickle:  \n",
    "                with open(pickle_path, 'wb') as handle:\n",
    "                    pickle.dump(out, handle, protocol=pickle.HIGHEST_PROTOCOL)\n",
    "\n",
    "# salvo i risultati totali nel file .pickle\n",
    "if savepickle:\n",
    "    with open(pickle_path, 'wb') as handle:\n",
    "        pickle.dump(out, handle, protocol=pickle.HIGHEST_PROTOCOL)\n",
    "\n",
    "    with open(scan_folder + rf\"\\{scan_name}_info_{timesstamp}.txt\", \"w\") as text_file:           \n",
    "        text_file.write(    \n",
    "            \"# PARAMETRI SIM:\\n\"\n",
    "            f\"sim.boundary = {sim.boundary}\\n\"\n",
    "            f\"sim.gravity = {sim.gravity}\\n\"\n",
    "            f\"sim.integrator = {sim.integrator}\\n\"\n",
    "            f\"sim.softening = {sim.softening:.1f}\\n\"\n",
    "            f\"sim.opening_angle2 = {sim.opening_angle2:.1f}\\n\\n\"\n",
    "\n",
    "            \"# PARAMETRI SETUP:\\n\"\n",
    "            f\"boxL = {S.boxL:.0f}\\n\"\n",
    "            f\"nx = {S.nx:.0f}\\n\"\n",
    "            f\"ny = {S.ny:.0f}\\n\"\n",
    "            f\"x0_BH = {S.x0_BH:3f}\\n\"\n",
    "            f\"N = {S.N:.0f}\\n\"\n",
    "            f\"nrows = {S.nrows:.0f}\\n\"\n",
    "            f\"T = {S.T:.3f}\\n\\n\"           \n",
    "\n",
    "            \"# PARAMETRI GRIGLIA m x M x V:\\n\"\n",
    "            f\"M_grid = {M_grid}\\n\"\n",
    "            f\"m_grid = {m_grid}\\n\"\n",
    "            f\"V_grid = {V_grid}\\n\"\n",
    "            f\"V_scale = {V_scale}\\n\"\n",
    "            # f\"scales = {scales}\\n\"         # se utilizzo scale\n",
    "\n",
    "        )\n"
   ]
