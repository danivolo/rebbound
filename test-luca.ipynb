    "def gaussian(mu,sigma,x):\n",
    "    return 1/(sigma * np.sqrt(2 * np.pi)) *np.exp( - (x - mu)**2 / (2 * sigma**2) )\n",
    "\n",
    "mus = [10,50,100]\n",
    "scales = [4,16,64]       # 4, 7, 10 sono tre valori di prova per i quali le velocità sono comunque tutte negative (nella sim non ci saranno particelle che vanno verso dx)\n",
    "\n",
    "fig, ax = plt.subplots(3,1,figsize=(8,6))\n",
    "for i,scale in enumerate(scales):\n",
    "    for mu in mus:\n",
    "        \n",
    "        sigma = np.abs(mu/scale)\n",
    "        s = sp.particles_initial_velocity('gaussian', mu, scale, numb = 500)       # distribuzione utilizzata sotto per generare le velocità delle stelle\n",
    "        bins = ax[i].hist(s, 30, density=True, alpha = 0.5)[1]\n",
    "        ax[i].plot(bins, gaussian(-mu,sigma,bins), linewidth=2 ,alpha = 0.5)   \n",
    "        ax[i].set_xlim(-200,0)\n",
    "        ax[i].set_ylabel(\"Densità numerica\")\n",
    " \n",
    "ax[0].set_title(\"Distribuzioni di velocità gaussiane\")\n",
    "ax[2].set_xlabel(\"Vx\")\n",
    "plt.show()"
   ]
  },
  {
